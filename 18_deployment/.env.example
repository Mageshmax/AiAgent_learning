# Copy this file to .env and fill it in. NEVER commit .env to git.

# Your Claude API key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Keys YOUR users type into the chat page. Comma-separated, one per person.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_ACCESS_KEYS=change-me-1,change-me-2

# Optional settings (these are the defaults)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# RATE_LIMIT_PER_MINUTE=10
# MAX_MESSAGE_CHARS=2000
# DATA_DIR=./data
# HOST=127.0.0.1
# PORT=8000
